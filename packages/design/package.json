{
  "name": "@visua/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compiles the root DESIGN.md (Google DESIGN.md format) into CSS custom properties and typed tokens for the 2D UI and the 3D scene.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./generated/tokens.css",
    "./parse": "./src/parse.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  }
}
