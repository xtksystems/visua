{
  "name": "@visua/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visua API: workspaces, assessments, tasks, evidence, policies, agents (Claude + offline), connectors, exports, trust center and live events (SSE).",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
