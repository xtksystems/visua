    "seed": "node --disable-warning=ExperimentalWarning src/seed/cli.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@visua/agents": "workspace:*",
    "@visua/core": "workspace:*",
    "@visua/frameworks": "workspace:*",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  }
}
